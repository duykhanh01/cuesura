{
  "source": "synthetic, hand-written for parser tests; not harness output",
  "cases": [
    { "name": "coder done", "role": "coder", "expect": "valid",
      "value": { "schema_version": 1, "status": "done", "summary": "Implemented the task criteria", "questions": [], "blocker": null } },
    { "name": "fixer needs_input with options", "role": "fixer", "expect": "valid",
      "value": { "schema_version": 1, "status": "needs_input", "summary": "Two valid fixes", "questions": [{ "question": "Keep the old flag?", "options": ["keep", "remove"] }], "blocker": null } },
    { "name": "coder blocked", "role": "coder", "expect": "valid",
      "value": { "schema_version": 1, "status": "blocked", "summary": "Cannot proceed", "questions": [], "blocker": "Gate command missing from snapshot" } },
    { "name": "coder needs_context", "role": "coder", "expect": "valid",
      "value": { "schema_version": 1, "status": "needs_context", "summary": "Missing spec", "questions": [], "blocker": "Acceptance criteria truncated" } },
    { "name": "reviewer approve with minor finding", "role": "reviewer", "expect": "valid",
      "value": { "schema_version": 1, "verdict": "approve", "summary": "Looks correct", "findings": [{ "severity": "minor", "file": "src/a.ts", "line": 3, "message": "Name could be clearer" }] } },
    { "name": "reviewer request_changes file-level", "role": "reviewer", "expect": "valid",
      "value": { "schema_version": 1, "verdict": "request_changes", "summary": "Missing test", "findings": [{ "severity": "major", "file": "test/a.test.ts", "line": null, "message": "No regression test" }] } },

    { "name": "extra key (task id claimed by model)", "role": "coder", "expect": "structure",
      "value": { "schema_version": 1, "status": "done", "summary": "ok", "questions": [], "blocker": null, "task_id": "t1" } },
    { "name": "blocker omitted instead of null", "role": "coder", "expect": "structure",
      "value": { "schema_version": 1, "status": "done", "summary": "ok", "questions": [] } },
    { "name": "unknown status", "role": "fixer", "expect": "structure",
      "value": { "schema_version": 1, "status": "success", "summary": "ok", "questions": [], "blocker": null } },
    { "name": "wrong schema version", "role": "coder", "expect": "structure",
      "value": { "schema_version": 2, "status": "done", "summary": "ok", "questions": [], "blocker": null } },
    { "name": "reviewer schema given to coder", "role": "coder", "expect": "structure",
      "value": { "schema_version": 1, "verdict": "approve", "summary": "ok", "findings": [] } },
    { "name": "fractional line", "role": "reviewer", "expect": "structure",
      "value": { "schema_version": 1, "verdict": "request_changes", "summary": "x", "findings": [{ "severity": "major", "file": "a.ts", "line": 1.5, "message": "m" }] } },
    { "name": "truncated (not an object)", "role": "reviewer", "expect": "structure",
      "value": "{\"schema_version\":1,\"verdict\":\"appr" },

    { "name": "done with blocker", "role": "coder", "expect": "semantic",
      "value": { "schema_version": 1, "status": "done", "summary": "ok", "questions": [], "blocker": "x" } },
    { "name": "needs_input without question", "role": "fixer", "expect": "semantic",
      "value": { "schema_version": 1, "status": "needs_input", "summary": "?", "questions": [], "blocker": null } },
    { "name": "blocked without blocker", "role": "coder", "expect": "semantic",
      "value": { "schema_version": 1, "status": "blocked", "summary": "stuck", "questions": [], "blocker": null } },
    { "name": "blank summary", "role": "coder", "expect": "semantic",
      "value": { "schema_version": 1, "status": "done", "summary": "   ", "questions": [], "blocker": null } },
    { "name": "approve with critical finding", "role": "reviewer", "expect": "semantic",
      "value": { "schema_version": 1, "verdict": "approve", "summary": "ok", "findings": [{ "severity": "critical", "file": "a.ts", "line": 1, "message": "data loss" }] } },
    { "name": "request_changes without findings", "role": "reviewer", "expect": "semantic",
      "value": { "schema_version": 1, "verdict": "request_changes", "summary": "no", "findings": [] } },
    { "name": "request_changes with only minor findings", "role": "reviewer", "expect": "semantic",
      "value": { "schema_version": 1, "verdict": "request_changes", "summary": "no", "findings": [{ "severity": "minor", "file": "a.ts", "line": 1, "message": "naming" }] } },
    { "name": "finding path escapes repo", "role": "reviewer", "expect": "semantic",
      "value": { "schema_version": 1, "verdict": "request_changes", "summary": "no", "findings": [{ "severity": "minor", "file": "../etc/passwd", "line": 0, "message": "m" }] } }
  ]
}
