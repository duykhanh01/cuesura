{
  "name": "cuesura",
  "version": "0.0.0",
  "private": true,
  "description": "Cuesura: deterministic workflow engine for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project default",
    "test:reliability": "vitest run --project reliability",
    "build": "tsc -p tsconfig.build.json",
    "report:invariants": "node scripts/report-invariants.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "uuid": "14.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
