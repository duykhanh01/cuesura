# https://gitlab.com/apparmor/apparmor/-/raw/v4.0.2/profiles/apparmor/profiles/extras/bwrap-userns-restrict
# Modified 2026-10-28: Cuesura profile names; no local capability overrides.
# No warranty; license text is in COPYING alongside this file.
# Administrative provisioning only; leaves the host userns sysctl unchanged.
abi <abi/4.0>,
include <tunables/global>

profile cusr-bwrap /usr/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Keep confinement stacked across exec under bubblewrap's no_new_privs.
  allow px /** -> cusr-bwrap//&cusr-bwrap-child,
}

profile cusr-bwrap-child flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Descendants, including another bwrap or a copied executable, retain this denial.
  allow pix /** -> &cusr-bwrap-child,
  audit deny capability,
}
